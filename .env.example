# =============================================================================
# GitPulse — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://gitpulse:gitpulse@localhost:5432/gitpulse"

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# NEXTAUTH (Web App)
# Generate secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# GITHUB OAUTH
# Create at: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000
# - Callback URL: http://localhost:3000/api/auth/callback/github
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# -----------------------------------------------------------------------------
# API (Express Backend)
# -----------------------------------------------------------------------------
PORT=4000
API_URL="http://localhost:4000"

# Generate secret: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-min-32-chars"

# Shared secret between Next.js and Express for internal requests
# Generate: openssl rand -base64 32
API_INTERNAL_SECRET="your-internal-secret-min-32-chars"

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000"

# Logging level: debug | info | warn | error
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# AI — Phase 3+
# -----------------------------------------------------------------------------
# (OpenAI is no longer required, GitPulse uses free local embeddings!)

# -----------------------------------------------------------------------------
# VECTOR DATABASE (Phase 3+)
# Get your key at: https://app.pinecone.io
# NOTE: Create an index named "gitpulse" with 384 dimensions and "cosine" metric
# -----------------------------------------------------------------------------
PINECONE_API_KEY="pcsk-..."
PINECONE_INDEX="gitpulse"

# Number of code chunks sent per OpenAI embedding API call (default: 100)
EMBEDDING_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# GITHUB API (Phase 1+)
# -----------------------------------------------------------------------------
GITHUB_TOKEN="ghp_..."
